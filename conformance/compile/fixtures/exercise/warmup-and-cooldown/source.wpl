PLAN "Warmup And Cooldown"
TYPE workout
VISIBILITY public

GOALS

PHASES
  PHASE "Training" (1 weeks):
    WEEK 1:
      DAY Monday training "Full Session":
        warmup:
          jumping_jack 3x30s
          arm_circles 2x20s
        main straight_sets:
          push_up 3x10 rest 60 seconds
          squat 3x10 rest 60 seconds
        cooldown:
          recovery stretching:
            hamstring_stretch 30s x2 sides both
            chest_stretch 30s x2 sides both
