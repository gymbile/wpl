{
  "$schema": "https://wpl.dev/schemas/wpl/v1.schema.json",
  "plan": {
    "goals": [],
    "id": "<UUID>",
    "metadata": {
      "language": "en"
    },
    "name": "Plan Source",
    "personalization": {
      "inputs": [
        {
          "id": "week_number",
