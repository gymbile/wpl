{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wpl.dev/data/exercises.schema.json",
  "title": "WPL Canonical Exercise Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "categories"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upper_body", "lower_body", "core", "cardio_warmup",
        "stretching", "full_body", "rehab_mobility"
      ],
      "patternProperties": {
        "^[a-z_]+$": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" }
        }
      }
    }
  }
}
